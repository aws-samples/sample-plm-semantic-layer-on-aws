  "proposedDefects": [
   {
    "brief": "one reference points to a superseded revision of a remote part",
    "data": "externalRefs FR3102 -> urn:plm:de:part:D-31002 expects revision 01; D-31002 is at 02 and lists 01 under supersededRevisions",
    "ruleNeeded": "staleRevision: an external reference whose expected revision is not the current revision of the referenced part; needs part revision and lifecycle in the PLM schemas and a reference_externe-style table in the layer"
   },
   {
    "brief": "one external key points to a part that does not exist",
    "data": "externalRefs UK/3103 -> urn:plm:es:part:ES-3108; no such part; the expressible analogue today is the orphan plug UK-3103-J01 on IF-109",
    "ruleNeeded": "danglingReference: an external reference URN that resolves to no part in any PLM; needs external references in the link store"
   },
   {
    "brief": "one mass attribute is in the wrong unit",
    "data": "UK/3103 trip counter stores mass 0.6 with massUnit kg in a PLM whose mass column is mass_lb (the true mass is 0.6 kg = 1.32 lb); the expressible analogue today is the unit defect on IF-105",
    "ruleNeeded": "massUnit: a part mass whose unit is not the PLM's storage unit; needs mass and its unit in the part tables and the layer"
   }
  ],
