  skos:prefLabel "ISO 3601-1 222A" ; skos:altLabel "O-ring ISO 3601-1 - 222A - 37,69 x 3,53 - N" ;
  atelier:innerDiameter atelier:AS568Dash222InnerDiameter ; atelier:crossSection atelier:AS568Dash222CrossSection .

atelier:ISO3601Size332A a skos:Concept ; skos:inScheme atelier:ORingSizes ;
  skos:prefLabel "ISO 3601-1 332A" ; skos:altLabel "O-ring ISO 3601-1 - 332A - 50,17 x 5,33 - N" ;
  atelier:innerDiameter atelier:AS568Dash332InnerDiameter ; atelier:crossSection atelier:AS568Dash332CrossSection .

# Materials: one concept per material, adhesive or compound, with each language's words as labels. A compound carries
# its hardness and qualifiers in its labels, so EPDM 80 Shore A resistant to phosphate esters is one concept whatever
# language a site writes it in.

atelier:Materials a skos:ConceptScheme ;
  rdfs:label "Materials" ;
  rdfs:comment "Materials, adhesives and elastomer compounds of purchased items, with each site's words for them." ;
  skos:hasTopConcept atelier:PolycarbonateFilm, atelier:AcrylicPressureSensitiveAdhesive, atelier:EPDM80PhosphateEsterResistant,
    atelier:EPDM70SteamResistant, atelier:NBR70, atelier:FKM75, atelier:AluminiumAlloy .

atelier:PolycarbonateFilm a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "polycarbonate film"@en, "film polycarbonate"@fr, "Polycarbonatfolie"@de, "película de policarbonato"@es ;
  skos:definition "Polycarbonate film a placard is printed on; its thickness is stated with it." .

atelier:AcrylicPressureSensitiveAdhesive a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "acrylic pressure-sensitive adhesive"@en, "adhésif acrylique"@fr, "Acrylat-Haftklebstoff"@de,
    "adhesivo acrílico sensible a la presión"@es ;
  skos:altLabel "acrylic pressure-sensitive"@en, "adhésif acrylique sensible à la pression"@fr, "adhesivo acrílico"@es ;
  skos:definition "Permanent acrylic pressure-sensitive adhesive." .

atelier:EPDM80PhosphateEsterResistant a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "EPDM 80 Shore A, phosphate ester resistant"@en, "EPDM 80 Shore A, résistant aux esters phosphates"@fr,
    "EPDM 80 Shore A, phosphatesterbeständig"@de, "EPDM 80 Shore A, resistente a ésteres fosfato"@es ;
  skos:definition "EPDM of hardness 80 Shore A for phosphate ester hydraulic fluids." .

atelier:EPDM70SteamResistant a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "EPDM 70 Shore A, steam resistant"@en, "EPDM 70 Shore A, résistant à la vapeur"@fr,
    "EPDM 70 Shore A, heißdampfbeständig"@de, "EPDM 70 Shore A, resistente al vapor"@es ;
  skos:definition "EPDM of hardness 70 Shore A for steam and hot water." .

atelier:NBR70 a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "NBR 70 Shore A, mineral oil resistant"@en, "NBR 70 Shore A, résistant aux huiles minérales"@fr,
    "NBR 70 Shore A, mineralölbeständig"@de, "NBR 70 Shore A, resistente a aceites minerales"@es ;
  skos:definition "Nitrile rubber of hardness 70 Shore A for mineral oil hydraulic fluids." .

atelier:AluminiumAlloy a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "aluminium alloy"@en, "alliage d'aluminium"@fr, "Aluminiumlegierung"@de, "aleación de aluminio"@es ;
  skos:definition "Aluminium alloy of a container shell." .

atelier:FKM75 a skos:Concept ; skos:inScheme atelier:Materials ;
  skos:prefLabel "FKM 75 Shore A"@en, "FKM 75 Shore A"@fr, "FKM 75 Shore A"@de, "FKM 75 Shore A"@es ;
  skos:definition "Fluoroelastomer of hardness 75 Shore A." .

# The ornithopter's purchased cord and ballast can: two item classes and their materials, data in the vocabulary.

atelier:CordItem a skos:Concept ;
  skos:inScheme atelier:ItemClasses ; skos:topConceptOf atelier:ItemClasses ;
  skos:notation "cord" ;
  skos:prefLabel "Cord"@en, "Cordon"@fr, "Schnur"@de, "Cuerda"@es ;
  skos:definition "A braided or twisted cord bought by the length: one item when the nominal diameters agree within 0.1 mm and the materials are one material." ;
  atelier:identifiedBy atelier:CordDiameterAttribute, atelier:CordMaterialAttribute .

atelier:CordDiameterAttribute atelier:onAttribute atelier:nominalDiameter ; atelier:attributeOrder 1 ; atelier:stagingKey "diameter" ;
  atelier:matchToleranceMm "0.1"^^xsd:decimal .
atelier:CordMaterialAttribute atelier:onAttribute atelier:material ; atelier:attributeOrder 2 ;
  atelier:resolvedIn atelier:Materials .

atelier:CanisterItem a skos:Concept ;
  skos:inScheme atelier:ItemClasses ; skos:topConceptOf atelier:ItemClasses ;
  skos:notation "canister" ;
  skos:prefLabel "Canister"@en, "Bidon"@fr, "Kanister"@de, "Bidón"@es ;
  skos:definition "A rigid liquid container bought to a size: one item when base width, depth and height agree within 1 mm and the shell materials are one material." ;
  atelier:identifiedBy atelier:CanisterWidthAttribute, atelier:CanisterDepthAttribute, atelier:CanisterHeightAttribute,
    atelier:CanisterMaterialAttribute .

atelier:CanisterWidthAttribute atelier:onAttribute atelier:baseWidth ; atelier:attributeOrder 1 ; atelier:stagingKey "baseWidth" ;
  atelier:matchToleranceMm "1"^^xsd:decimal .
atelier:CanisterDepthAttribute atelier:onAttribute atelier:itemDepth ; atelier:attributeOrder 2 ; atelier:stagingKey "depth" ;
  atelier:matchToleranceMm "1"^^xsd:decimal .
atelier:CanisterHeightAttribute atelier:onAttribute atelier:itemHeight ; atelier:attributeOrder 3 ; atelier:stagingKey "height" ;
  atelier:matchToleranceMm "1"^^xsd:decimal .
atelier:CanisterMaterialAttribute atelier:onAttribute atelier:shellMaterial ; atelier:attributeOrder 4 ; atelier:stagingKey "material" ;
  atelier:resolvedIn atelier:Materials .

atelier:RawSilk a skos:Concept ; skos:inScheme atelier:Materials ; skos:topConceptOf atelier:Materials ;
  skos:prefLabel "raw silk"@en, "soie grège"@fr, "Rohseide"@de, "seda cruda"@es ;
  skos:definition "Silk as reeled from the cocoon, not degummed." .

atelier:Polyethylene a skos:Concept ; skos:inScheme atelier:Materials ; skos:topConceptOf atelier:Materials ;
  skos:prefLabel "polyethylene"@en, "polyéthylène"@fr, "Polyethylen"@de, "polietileno"@es ;
  skos:definition "Polyethylene of a moulded container shell." .

# Function: what drives what. A bill of materials says what contains what; the drives relation says where power or
# motion goes, from a part to the next, across the sites. No site holds both ends of a joint between two sites, so
# the relation is the layer's own engineering knowledge, published in the link store as the interfaces are: one
# atelier:Drive per edge (its driving and driven part, flow kind, the interface joining them when the joint is one,
# and for a planetary stage the gear held fixed), with the plain atelier:drives triple beside it for navigation.

atelier:Drive a owl:Class ;
  rdfs:label "Drive" ;
  rdfs:comment "A functional edge: power or motion passes from atelier:driver to atelier:driven. Published in the link store; IRI https://example.com/atelier/drive/{product}/{n}." .

atelier:drives a owl:ObjectProperty ;
  rdfs:label "drives" ;
  rdfs:comment "Power or motion passes from this part to the object part (atelier:drives+ follows a product's function). Stated by the link store beside each atelier:Drive." ;
  owl:propertyChainAxiom ( [ owl:inverseOf atelier:driver ] atelier:driven ) ;
  rdfs:domain atelier:Part ;
  rdfs:range atelier:Part .

atelier:driver a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "driver" ;
  rdfs:comment "The part a functional edge starts from." ;
  rdfs:domain atelier:Drive ;
  rdfs:range atelier:Part .

atelier:driven a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "driven" ;
  rdfs:comment "The part a functional edge ends at." ;
  rdfs:domain atelier:Drive ;
  rdfs:range atelier:Part .

atelier:flow a owl:DatatypeProperty ;
  rdfs:label "flow" ;
  rdfs:comment "What the edge carries: mechanical, electrical, hydraulic or steam." ;
  rdfs:domain atelier:Drive ;
  rdfs:range xsd:string .

atelier:viaInterface a owl:ObjectProperty ;
  rdfs:label "via interface" ;
  rdfs:comment "The interface joining the edge's two parts, when the joint is one. A gear mesh or a shaft carrying a wheel inside one site has none." ;
  rdfs:domain atelier:Drive ;
  rdfs:range atelier:Interface .

atelier:reactionPart a owl:ObjectProperty ;
  rdfs:label "reaction part" ;
  rdfs:comment "The fixed gear the driving gear also meshes (a planetary ring). The driven sun then turns at sun over ring plus sun, not through the planet's teeth." ;
  rdfs:domain atelier:Drive ;
  rdfs:range atelier:Part .

atelier:ratedSpeedRpm a owl:DatatypeProperty ;
  rdfs:label "rated speed (rpm)" ;
  rdfs:comment "Speed at the rated operating point, in rpm. A design figure, published in the link store with the functional edges." ;
  rdfs:domain atelier:Part ;
  rdfs:range xsd:decimal .

atelier:toothCount a owl:DatatypeProperty ;
  rdfs:label "tooth count" ;
  rdfs:comment "Teeth of a gear. A stepped cluster of several gears states none." ;
  rdfs:domain atelier:Part ;
  rdfs:range xsd:integer .

atelier:gearModule a owl:ObjectProperty ;
  rdfs:label "gear module" ;
  rdfs:comment "Gear module (pitch diameter over teeth). A quantity value in millimetres, or inches in the British PLM; node IRI <part IRI>/module." ;
  rdfs:domain atelier:Part ;
  rdfs:range qudt:QuantityValue .

# Stations and sections: positions along a product's station axis, published by the layer in the link store with the
# product's sections. A part's span along the axis is stored by its PLM and computed from its CAD geometry.

atelier:Station a owl:Class ;
  rdfs:label "Station" ;
  rdfs:comment "A named position along the product's station axis, such as a wing station. Its id is its skos:notation, its source a dcterms:source; product data the layer publishes in the link store, which no PLM holds. IRI https://example.com/atelier/station/{product}/{id}." .

atelier:Section a owl:Class ;
  rdfs:label "Section" ;
  rdfs:comment "A stretch of the product between stations, owned by one site. Two sections that share a station meet at a joint there. IRI https://example.com/atelier/section/{product}/{id}." .

atelier:stationAxis a owl:DatatypeProperty ;
  rdfs:label "station axis" ;
  rdfs:comment "x, y or z." ;
  rdfs:domain atelier:Product ;
  rdfs:range xsd:string .

atelier:stationsSymmetric a owl:DatatypeProperty ;
  rdfs:label "stations symmetric" ;
  rdfs:comment "True when station n is at +n on the right and -n on the left." ;
  rdfs:domain atelier:Product ;
  rdfs:range xsd:boolean .

atelier:stationMeasure a owl:DatatypeProperty ;
  rdfs:label "station measure" ;
  rdfs:comment "In words." ;
  rdfs:domain atelier:Product ;
  rdfs:range xsd:string .

atelier:stationPosition a owl:ObjectProperty ;
  rdfs:label "station position" ;
  rdfs:comment "In millimetres along the axis; node IRI <station IRI>/position." ;
  rdfs:domain atelier:Station ;
  rdfs:range qudt:QuantityValue .

atelier:stationTolerance a owl:ObjectProperty ;
  rdfs:label "station tolerance" ;
  rdfs:comment "Accuracy of the position in millimetres, when read from a drawing or a model; node IRI <station IRI>/tolerance." ;
  rdfs:domain atelier:Station ;
  rdfs:range qudt:QuantityValue .

atelier:stationBasis a owl:ObjectProperty ;
  rdfs:label "station basis" ;
  rdfs:comment "A concept of atelier:StationBases: printed, measured, joint or inferred." ;
  rdfs:domain atelier:Station ;
  rdfs:range skos:Concept .

atelier:sectionOf a owl:ObjectProperty ;
  rdfs:label "section of" ;
  rdfs:comment "Its product." ;
  rdfs:range atelier:Product .

atelier:hasStation a owl:ObjectProperty ;
  rdfs:label "has station" ;
  rdfs:comment "A station of the section." ;
  rdfs:domain atelier:Section ;
  rdfs:range atelier:Station .

atelier:sectionSide a owl:DatatypeProperty ;
  rdfs:label "section side" ;
  rdfs:comment "left, right or both." ;
  rdfs:domain atelier:Section ;
  rdfs:range xsd:string .

atelier:sectionPart a owl:ObjectProperty ;
  rdfs:label "section part" ;
  rdfs:comment "The part the section is, when one part is the section." ;
  rdfs:domain atelier:Section ;
  rdfs:range atelier:Part .

atelier:spanFrom a owl:ObjectProperty ;
  rdfs:label "span from" ;
  rdfs:comment "Lowest coordinate of a part or an occurrence along the station axis, in millimetres or inches in the British PLM; node IRI <subject>/span-from. Computed from the CAD geometry, never entered." ;
  rdfs:range qudt:QuantityValue .

atelier:spanTo a owl:ObjectProperty ;
  rdfs:label "span to" ;
  rdfs:comment "Highest coordinate along the station axis; node IRI <subject>/span-to." ;
  rdfs:range qudt:QuantityValue .

atelier:StationBases a skos:ConceptScheme ;
  rdfs:label "Station bases" ;
  rdfs:comment "How a station's position is known." ;
  skos:hasTopConcept atelier:PrintedStation, atelier:MeasuredStation, atelier:JointStation, atelier:InferredStation .

atelier:PrintedStation a skos:Concept ; skos:inScheme atelier:StationBases ; skos:notation "printed" ;
  skos:prefLabel "printed"@en ; rdfs:comment "Printed on a drawing or in a manual." .

atelier:MeasuredStation a skos:Concept ; skos:inScheme atelier:StationBases ; skos:notation "measured" ;
  skos:prefLabel "measured"@en ; rdfs:comment "Measured on the product or a model of it." .

atelier:JointStation a skos:Concept ; skos:inScheme atelier:StationBases ; skos:notation "joint" ;
  skos:prefLabel "joint"@en ; rdfs:comment "Where two sections or parts are joined." .

atelier:InferredStation a skos:Concept ; skos:inScheme atelier:StationBases ; skos:notation "inferred" ;
  skos:prefLabel "inferred"@en ; rdfs:comment "Inferred from the geometry or another source; no source prints it." .

# Variants and option effectivity: a variant is one installation slot of a product and the options it can take,
# published by the layer in the options graph of the link store (https://example.com/atelier/graph/options). The
# base product is the default configuration: the default option names the base items it is made of, and every other
# option the items only it adds. A row a site holds only for one option carries the option's code, which the
# mappings read as atelier:appliesUnderOption; a feature's port is the connection point its host part offers the
# slot, the same under every option, so two options are compared port by port.

atelier:Variant a owl:Class ;
  rdfs:label "Variant" ;
  rdfs:comment "One installation slot of a product and the options it can take (a variant group). IRI https://example.com/atelier/variant/{product}/{group}; its product is atelier:ofProduct." .

atelier:Option a owl:Class ;
  rdfs:label "Option" ;
  rdfs:comment "One alternative of a variant: what the slot holds when the option is taken. IRI https://example.com/atelier/option/{option code}, the code the sites store on the rows that exist only under it." .

atelier:optionOf a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "option of" ;
  rdfs:comment "The variant an option is an alternative of." ;
  rdfs:domain atelier:Option ;
  rdfs:range atelier:Variant .

atelier:defaultOption a owl:ObjectProperty , owl:FunctionalProperty ;
  rdfs:label "default option" ;
  rdfs:comment "The option the base product is built with: the default configuration of the variant." ;
  rdfs:domain atelier:Variant ;
  rdfs:range atelier:Option .

atelier:appliesUnderOption a owl:ObjectProperty ;
  rdfs:label "applies under option" ;
  rdfs:comment "An item, feature, interface, bill-of-materials line or functional edge that the product holds only when this option is taken. A default option's items are base items; another option's exist nowhere in the base." ;
  rdfs:range atelier:Option .

atelier:applicability a owl:DatatypeProperty ;
  rdfs:label "applicability" ;
  rdfs:comment "The product model or build an option applies to, and what of it the data does not model, in words." ;
  rdfs:domain atelier:Option ;
  rdfs:range xsd:string .

atelier:portNotModelled a owl:DatatypeProperty ;
  rdfs:label "port not modelled" ;
  rdfs:comment "A port the host offers under this option that the data does not hold: present, never compared." ;
  rdfs:domain atelier:Option ;
  rdfs:range xsd:string .

atelier:port a owl:DatatypeProperty ;
  rdfs:label "port" ;
  rdfs:comment "The connection point of its host part a feature serves (a return eye, a bearing, a flange), named the same under every option of the slot; at most one feature of a part per port in a configuration." ;
  rdfs:domain atelier:InterfaceFeature ;
  rdfs:range xsd:string .
