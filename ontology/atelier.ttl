atelier:AS568Dash332InnerDiameter qudt:numericValue "50.17"^^xsd:decimal ; qudt:unit <http://qudt.org/vocab/unit/MilliM> .
atelier:AS568Dash332CrossSection qudt:numericValue "5.33"^^xsd:decimal ; qudt:unit <http://qudt.org/vocab/unit/MilliM> .

