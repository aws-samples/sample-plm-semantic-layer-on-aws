atelier:AS568Dash222InnerDiameter qudt:numericValue "37.69"^^xsd:decimal ; qudt:unit <http://qudt.org/vocab/unit/MilliM> .
atelier:AS568Dash222CrossSection qudt:numericValue "3.53"^^xsd:decimal ; qudt:unit <http://qudt.org/vocab/unit/MilliM> .

