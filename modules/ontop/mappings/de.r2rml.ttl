  rr:subjectMap [ rr:template "https://example.com/atelier/de/occurrence/{parent_id}/{teil_nr}/{lfd_nr}/translation/z" ; rr:class qudt:QuantityValue ] ;
  rr:predicateObjectMap [ rr:predicate qudt:numericValue ; rr:objectMap [ rr:column "z_mm" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate qudt:unit ; rr:object unit:MilliM ] .

