@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prod: <https://example.com/atelier/product/> .

prod:drivetrain atelier:stationAxis "y" ; atelier:stationsSymmetric true ; atelier:stationMeasure "mm from the centre plane" .

