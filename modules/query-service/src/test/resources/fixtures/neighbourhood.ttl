  atelier:positionX frp:J31\/position\/x ; atelier:positionY frp:J31\/position\/y ; atelier:positionZ frp:J31\/position\/z .
frp:J31\/position\/x a qudt:QuantityValue ; qudt:numericValue 20000.000 ; qudt:unit unit:MilliM .
frp:J31\/position\/y a qudt:QuantityValue ; qudt:numericValue 0.000 ; qudt:unit unit:MilliM .
frp:J31\/position\/z a qudt:QuantityValue ; qudt:numericValue 1500.000 ; qudt:unit unit:MilliM .
