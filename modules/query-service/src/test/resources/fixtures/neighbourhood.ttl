espt:es-tail-plane atelier:partOf <https://example.com/atelier/product/ornithopter> , <https://example.com/atelier/product/tail> .

ifo:IF-01 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/ornithopter> ; atelier:label "Control post / right wing root fitting" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart frpt:fr-control-post , dept:de-right-root-fitting ; atelier:declaresFeature frp:J11 , dep:P11 .
ifo:IF-02 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/ornithopter> ; atelier:label "Right wing root fitting / mid cross beam" ; atelier:toleranceMm "2"^^xsd:decimal ;
  atelier:betweenPart dept:de-right-root-fitting , frpt:fr-cross-beam-mid ; atelier:declaresFeature dep:J21 , frp:P21 .
ifo:IF-03 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/ornithopter> ; atelier:label "Mid cross beam / right inner spar" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart frpt:fr-cross-beam-mid , dept:de-right-inner-spar ; atelier:declaresFeature frp:J31 , dep:P31 .
ifo:IF-04 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/ornithopter> ; atelier:label "Right inner spar / tail boom" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart dept:de-right-inner-spar , espt:es-tail-boom ; atelier:declaresFeature def:RF-4 , esf:CC-4 , dec:HY-4 , esc:HZ-4 .
ifw:IF-05 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/wings> ; atelier:label "Mid cross beam / left wing root fitting" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart frpt:fr-cross-beam-mid , ukpt:uk-left-root-fitting ;
  atelier:declaresFeature frp:J51 , <https://example.com/atelier/uk/plug/HC%2051> , frf:RF-5 , <https://example.com/atelier/uk/fastener/FS%205> ,
                      frc:HY-5 , <https://example.com/atelier/uk/coupling/HYD%205> .
ifw:IF-06 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/wings> ; atelier:label "Mid cross beam / left wing actuator" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart frpt:fr-cross-beam-mid , ukpt:uk-left-wing-actuator ;
  atelier:declaresFeature frp:J61 , <https://example.com/atelier/uk/plug/HC%2061> , frc:HY-6 , <https://example.com/atelier/uk/coupling/HYD%206> .
ift:IF-07 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/tail> ; atelier:label "Tail boom / tail trim drive" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart espt:es-tail-boom , dept:de-tail-drive ; atelier:declaresFeature esp:J72 , dep:P71 , dep:P72 .
ift:IF-08 a atelier:Interface ; atelier:ofProduct <https://example.com/atelier/product/tail> ; atelier:label "Tail boom / tail plane" ; atelier:toleranceMm "2.0"^^xsd:decimal ;
  atelier:betweenPart espt:es-tail-boom , espt:es-tail-plane ; atelier:declaresFeature esp:J82 , esp:P82 .

