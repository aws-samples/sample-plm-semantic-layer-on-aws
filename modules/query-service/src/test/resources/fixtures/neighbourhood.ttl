  atelier:positionX dep:P31\/position\/x ; atelier:positionY dep:P31\/position\/y ; atelier:positionZ dep:P31\/position\/z .
dep:P31\/position\/x a qudt:QuantityValue ; qudt:numericValue 20000.000 ; qudt:unit unit:MilliM .
dep:P31\/position\/y a qudt:QuantityValue ; qudt:numericValue 0.000 ; qudt:unit unit:MilliM .
dep:P31\/position\/z a qudt:QuantityValue ; qudt:numericValue 1500.000 ; qudt:unit unit:MilliM .

# IF-04 fasteners (DE 6.35 mm vs ES 7.94 mm) and couplings (match)
