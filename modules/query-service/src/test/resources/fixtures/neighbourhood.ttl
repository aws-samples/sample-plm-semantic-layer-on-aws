<https://example.com/atelier/product/ornithopter> a atelier:Product ; atelier:label "Ornithopter ground demonstrator (Paris Manuscript B, f. 74v)" ;
  atelier:frame "x aft from the frame nose, y to the pilot's right, z up with z = 0 on the keel beam axis; mm" .
<https://example.com/atelier/product/wings> a atelier:Product ; atelier:label "Wings" .
<https://example.com/atelier/product/tail> a atelier:Product ; atelier:label "Tail unit" ; atelier:frame "x aft from the frame nose, y to the pilot's right, z up with z = 0 on the keel beam axis; mm" .
